server {
  listen 80;
  resolver 127.0.0.11 valid=10s;

  location = /statut {
    return 301 /statut/;
  }

  location /statut/ {
    set $amont_statut http://${nom_statut}:80;
    rewrite ^/statut/(.*)$ /$1 break;
    proxy_pass $amont_statut;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
  }

  location / {
    set $amont_app http://${nom_app}:3000;
    proxy_pass $amont_app;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }
}
